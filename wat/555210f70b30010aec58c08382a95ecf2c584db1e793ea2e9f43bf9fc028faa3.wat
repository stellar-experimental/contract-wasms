  (data (;0;) (i32.const 1048576) "SpEcV12\f9\f0\04-P\22MSpEcV1\1c%\9b?\9b'\9a\bfSpEcV1mx%\ea3\ca\0a\caRaterate\00\00.\00\10\00\04\00\00\00rate_updateamount\00\00\00G\00\10\00\06\00\00\00SpEcV1\d7Fpw\e8\124\e2SpEcV1\ae\87M@T\ed\be5SpEcV1|L\a6\7f\d9\b7\9dZSpEcV1dR\e8\81\b4&^\ecSpEcV1\e7\81\b0\0a:\ce\89Daddresslive_until_ledger\00\00\9e\00\10\00\07\00\00\00\a5\00\10\00\11\00\00\00OwnerPendingOwnernew_owner\00\00\d9\00\10\00\09\00\00\00ownership_transfer_completedold_owner\00\00\00\08\01\10\00\09\00\00\00ownership_renounced\00\a5\00\10\00\11\00\00\00\d9\00\10\00\09\00\00\00\08\01\10\00\09\00\00\00ownership_transfer")
  (@custom "contractenvmetav0" (after data) "\00\00\00\00\00\00\00\1a\00\00\00\00")
