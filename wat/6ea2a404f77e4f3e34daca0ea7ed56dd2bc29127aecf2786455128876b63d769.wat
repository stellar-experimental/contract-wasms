  (data (;2;) (i32.const 1049008) "caller\00\00\b0\01\10\00\06\00\00\00role_grantedrole_revokedadmin_renouncednew_admin_roleprevious_admin_role\e7\01\10\00\0e\00\00\00\f5\01\10\00\13\00\00\00role_admin_changedSpEcV1%\f9b\09f)e\b8SpEcV1\d3\5c\bf2\d6\ed\e57SpEcV1uX\ce\cbH\91\19\dcurischemeis_claim_validsignatureget_claim_ids_by_topicdataissuertopic\00\00\00\8a\02\10\00\04\00\00\00\8e\02\10\00\06\00\00\00W\02\10\00\06\00\00\00k\02\10\00\09\00\00\00\94\02\10\00\05\00\00\00T\02\10\00\03\00\00\00get_claim_topics_and_issuersstored_identityget_recovered_toClaimTopicsAndIssuersIdentityRegistryStorageclaim_topics_and_issuers_setidentity_registry_storage_set")
