              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Pulls `amount` from the allowlisted `from`, mints shares at the pre-deposit NAV (floor),\\nforwards the USDC to Sentora and mirrors it in `Principal`.",
      "name": "deposit",
      "inputs": [
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
