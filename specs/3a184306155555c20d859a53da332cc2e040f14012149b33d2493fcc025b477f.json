    "function_v0": {
      "doc": "`floor(shares * (NAV + 1) / (total_shares + 10^6))`, `NAV = Principal + idle`. Local\\nreads only: never calls Sentora, never writes.",
      "name": "balance",
      "inputs": [
        {
