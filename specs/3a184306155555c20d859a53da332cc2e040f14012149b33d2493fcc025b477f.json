                "name": "StrategyError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Keeper-only (dual check). The only place idle USDC (claimed rewards, donations) goes back\\ninto Sentora: a noop below `REINVEST_THRESHOLD`, otherwise `Principal += idle` and no\\nshares minted (the price per share already rose when the reward became idle). A Sentora\\nfailure is `ExternalError` and the idle stays idle. `data` is ignored (nothing is swapped).",
      "name": "harvest",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "data",
          "type_": {
            "option": {
              "value_type": "bytes"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "StrategyError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Pays `amount` to `to`: idle first, the rest from Sentora. Never allowlist-gated. A Sentora\\nrefusal (paused, short of USDC) is `ExternalError` and reverts everything.",
