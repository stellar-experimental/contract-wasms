  {
    "function_v0": {
      "doc": "Pays everything credited to `member`, always to `member`'s own address, once the circle is\\nclosed: until `retire` replaces them, claims wait, so nobody takes out money the table is\\nabout to share. Pays in full or not at all: while the contract holds less than all of its\\nclaims, nobody is paid first.",
      "name": "claim",
      "inputs": [
        {
          "doc": "",
          "name": "member",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Closes the circle and replaces every claim with the table: afterwards each address in it is\\nowed exactly its amount, and 0 clears what it was owed. The table must name every address\\nthe contract owes something to and add up to exactly the token balance. Sending the same\\ntable again returns the same retirement.",
      "name": "retire",
      "inputs": [
        {
          "doc": "",
          "name": "shares",
          "type_": {
            "map": {
              "key_type": "address",
              "value_type": "i128"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "udt": {
                "name": "Retirement"
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
