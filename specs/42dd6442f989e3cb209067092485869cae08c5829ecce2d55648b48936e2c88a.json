  {
    "function_v0": {
      "doc": "Returns the adapter for a registered route even when the route is disabled.\\n\\nUsed by the order manager on the refund path so that cutting off a misbehaving\\npartner cannot strand escrow already held against in-flight orders. Settlement and\\nnew creation continue to use [`Self::resolve`], which rejects disabled routes.",
      "name": "adapter",
      "inputs": [
        {
          "doc": "",
          "name": "provider_id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "address",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Resolves a route for settlement and new order creation.\\n\\nFails loudly for unknown or disabled routes so callers get an explicit error rather\\nthan silently falling through to a default. This is the entry point the order\\nmanager invokes for create/settle.",
      "name": "resolve",
      "inputs": [
        {
          "doc": "",
          "name": "provider_id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "address",
            "error_type": "error"
          }
        }
      ]
    }
  },
