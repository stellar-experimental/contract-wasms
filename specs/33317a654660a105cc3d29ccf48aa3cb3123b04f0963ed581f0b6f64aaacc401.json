[
  {
    "function_v0": {
      "doc": "Spend a one-time Stellar hop slot.\\n\\nAnyone (user or fee sponsor) may submit this transaction; only the holder\\nof the private key for `pk` can produce a valid `sig` for `(slot_id, target)`.\\n\\nPanics if:\\n- `env.ledger().timestamp() >= expires_at` (`slot_expired` \\xe2\\x80\\x94 auto-slept to Autonomi)\\n- `slot_id` was already spent (`already_spent` \\xe2\\x80\\x94 double-spend rejected)\\n- `sig` does not verify under `pk`",
      "name": "spend",
      "inputs": [
        {
          "doc": "",
          "name": "pk",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "expires_at",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "target",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "sig",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        }
      ],
      "outputs": [
        {
          "udt": {
            "name": "SpendEntry"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Read a spent slot (returns `None` if never spent).",
      "name": "get_slot",
      "inputs": [
