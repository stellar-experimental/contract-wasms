    "function_v0": {
      "doc": "Owner-only atomic liquidation entrypoint (invoked on the Orchestrator instance).\\n\\nSupports both:\\n- Zero-capital cross-pool Blend V2 flash loan (`plan.flash_amount > 0`)\\n- Same-asset direct liquidation (`plan.flash_amount == 0`, e.g. USDC->USDC)\\n\\nReverts atomically if realized net profit (`bal_after - bal_before`) is\\nstrictly below `plan.min_profit`. Returns net profit in `flash_asset` stroops.",
      "name": "liquidate",
      "inputs": [
        {
          "doc": "",
          "name": "plan",
          "type_": {
            "udt": {
              "name": "LiqPlan"
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
