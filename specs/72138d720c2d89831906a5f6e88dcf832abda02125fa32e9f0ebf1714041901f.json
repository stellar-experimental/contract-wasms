  {
    "function_v0": {
      "doc": "Swaps exactly `amount_in` of `token_in` for at least `min_out` of `token_out` through\\n`routes`, each route's hops run in order with this contract as caller and each hop's\\nreturned amount feeding the next. Returns the amount of `token_out` delivered. The fee is\\ntaken in `token_in`; the routes' shares add up to the post-fee amount.",
      "name": "swap_exact_in",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "min_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "routes",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Route"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "partner",
          "type_": {
            "option": {
              "value_type": {
                "udt": {
                  "name": "Partner"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Buys exactly `amount_out` of `token_out` for at most `max_in` of `token_in`, fee\\nincluded. Each route names the `token_out` it must deliver; the aggregator sizes every\\nhop's input backward on chain and runs the hops forward, with each venue's native\\nexact-output call where it has one. The fee is taken on the input consumed, the unused\\ninput is refunded, and anything delivered above `amount_out` goes to the treasury.\\nReturns the input spent, hops plus fee.",
      "name": "swap_exact_out",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "max_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "routes",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "RouteOut"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "partner",
          "type_": {
            "option": {
              "value_type": {
                "udt": {
                  "name": "Partner"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
