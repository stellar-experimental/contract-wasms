  {
    "udt_error_enum_v0": {
      "doc": "Numbering is part of the api contract: the api maps codes to messages.",
      "lib": "",
      "name": "AggregatorError",
      "cases": [
        {
          "doc": "",
          "name": "Paused",
          "value": 1
        },
        {
          "doc": "",
          "name": "InvalidAmount",
          "value": 2
        },
        {
          "doc": "",
          "name": "SameToken",
          "value": 3
        },
        {
          "doc": "A partner `bps` other than 0 (attribution only) outside `min_partner_bps..=MAX_BPS`.",
          "name": "PartnerBpsOutOfRange",
          "value": 4
        },
        {
          "doc": "Empty routes or hops, non-positive share or target, shares (exact-in) or targets\\n(exact-out) that do not add up, broken continuity, an Aqua hop without steps, an Aqua\\nreturn above `i128::MAX`, or a Sushi pool returning `i128::MIN` on the received leg,\\nwhere `checked_neg` fails. Exact-out also: a Comet hop anywhere but first in its\\nroute, or one pool used twice within a route.",
          "name": "BadRoute",
          "value": 5
        },
        {
          "doc": "A Comet hop left `allowance(aggregator, pool) > 0` after the call (exact-out: after\\nthe aggregator's own reset to zero).",
          "name": "AllowanceLeft",
          "value": 6
        },
        {
          "doc": "Delivered less than `min_out` (exact-in) or `amount_out` (exact-out). Exact-out also:\\na hop delivered less than its target, or a Curve/Phoenix reverse quote still came up\\nshort after three corrections.",
          "name": "InsufficientOutput",
          "value": 7
        },
        {
          "doc": "Exact-out: the hops consumed no input or more than `max_in`, or the input left cannot\\ncover the fee. Unreachable with honest venues once `ExcessiveInput` has passed.",
          "name": "InsufficientInput",
          "value": 8
        },
        {
          "doc": "",
          "name": "NoPendingAdmin",
          "value": 9
        },
        {
          "doc": "A dial above `MAX_BPS`, or `min_partner_bps < protocol_bps`.",
          "name": "BpsOutOfRange",
          "value": 10
        },
        {
          "doc": "`Partner.id` is longer than 9 characters (not a `SymbolSmall`).",
          "name": "PartnerIdTooLong",
          "value": 11
        },
        {
          "doc": "Config missing. Unreachable after the constructor; kept so the read has no unwrap.",
          "name": "NotInitialized",
          "value": 12
        },
        {
          "doc": "Exact-out: a route's first hop needs more `token_in` (quoted on chain) than `max_in`\\nleaves after the fee on `max_in` and the routes already run. The api's slippage on\\n`max_in` was not enough for the price at execution.",
          "name": "ExcessiveInput",
          "value": 13
        }
      ]
    }
  },
