  {
    "udt_error_enum_v0": {
      "doc": "Codes start at 100. The contracts a send passes through use 1 to 25 and 1000 and up (the\\nUSDT0 OFT, the LayerZero endpoint, send library, DVNs, executor, fee libraries, treasury and\\nprice feed) and the Stellar Asset Contract uses 1 to 15, so a bare `Error(Contract, #n)`\\nsays by its number alone whether Airlift refused or something downstream did.",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "",
          "name": "Paused",
          "value": 100
        },
        {
          "doc": "",
          "name": "TokenNotRegistered",
          "value": 101
        },
        {
          "doc": "",
          "name": "RouteNotRegistered",
          "value": 102
        },
        {
          "doc": "",
          "name": "InvalidAmount",
          "value": 103
        },
        {
          "doc": "",
          "name": "InvalidRecipient",
          "value": 104
        },
        {
          "doc": "",
          "name": "AmountTooSmall",
          "value": 105
        },
        {
          "doc": "",
          "name": "BelowMinAmount",
          "value": 106
        },
        {
          "doc": "",
          "name": "FeeTooHigh",
          "value": 107
        },
        {
          "doc": "",
          "name": "OftTokenMismatch",
          "value": 108
        },
        {
          "doc": "",
          "name": "PayoutToContract",
          "value": 109
        },
        {
          "doc": "",
          "name": "NoPendingAdmin",
          "value": 110
        },
        {
          "doc": "",
          "name": "UnsupportedConversionRate",
          "value": 111
        },
        {
          "doc": "",
          "name": "FlatDefaultFee",
          "value": 112
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "`amount_sent_ld`, `oft_fee_details` and `oft_limit` are the OFT's own `quote_oft` answer for\\n`amount_after_fee`, passed through unchanged. A contract caller pre-authorizes the OFT's burn\\nof `amount_received_ld` and any separate OFT token-fee transfer of `amount_sent_ld -\\namount_received_ld`, so it needs them to build its authorization tree without querying the OFT.",
      "lib": "",
      "name": "Quote",
      "fields": [
