  {
    "function_v0": {
      "doc": "Re-encode the listed signer entries from the pre-`6a27d48` storage\\nlayout into the current one. Returns how many entries were rewritten.\\n\\nDeliberately unauthenticated: the rewrite is value-preserving (same\\nkey, public key, expiration, limits, and durability), so there is\\nnothing for a third party to gain, and it lets an operator normalize\\nwallets in bulk without each owner's passkey. Reads are tolerant of\\nboth layouts anyway; this exists so a wallet can later move to a\\nstrict build (`ecd990f0\\xe2\\x80\\xa6`, `e45c42b9\\xe2\\x80\\xa6`, or v1) without decode failures.\\nKeys that are absent or already current are skipped. Soroban has no\\nstorage iteration, so the caller supplies the keys (the `sw_v1` events\\nor the passkey indexer list them).",
      "name": "migrate_signers",
      "inputs": [
        {
          "doc": "",
          "name": "signer_keys",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "SignerKey"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        "u32"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Read a signer entry in the current layout, whatever layout it is\\nstored in. `None` when no entry exists under the key.",
      "name": "get_signer",
      "inputs": [
        {
          "doc": "",
          "name": "signer_key",
          "type_": {
