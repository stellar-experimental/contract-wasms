  {
    "function_v0": {
      "doc": "Set the minimum number of distinct registered publishers whose signed\\nrounds `update_quorum_ed25519_persistent` must carry. Admin-\\nauthenticated. Must satisfy 1 <= quorum <= publishers.len() at set\\ntime; an unset quorum behaves as 1, so existing single-publisher\\ndeployments are unchanged until the admin raises the bar. (A later\\n`set_publishers` may shrink the key set below this threshold \\xe2\\x80\\x94 the\\nquorum path then cannot meet quorum until the admin re-syncs.)",
      "name": "set_quorum",
      "inputs": [
        {
          "doc": "",
          "name": "quorum",
          "type_": "u32"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "One publisher's signed contribution to a quorum submission: `prices[i]`\\nand `sigs[i]` align with the shared `assets` vector of the call. Rounds\\nare transient call data \\xe2\\x80\\x94 only the per-asset median is ever stored.",
      "lib": "",
      "name": "PublisherRound",
