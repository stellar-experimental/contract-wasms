    "function_v0": {
      "doc": "Arithmetic mean of the last min(records, stored) ring prices. This is\\na simple mean over stored ROUNDS, not a time-weighted average \\xe2\\x80\\x94\\nadequate for a consumer's median-of-last-k / smoothing eligibility\\nchecks, not for interval-exact TWAP accounting. `None` when the asset\\nhas no history or `records` is 0.",
      "name": "twap",
      "inputs": [
        {
          "doc": "",
          "name": "asset",
          "type_": {
            "bytes_n": {
              "n": 8
            }
          }
        },
        {
          "doc": "",
          "name": "records",
          "type_": "u32"
        }
      ],
      "outputs": [
        {
          "option": {
            "value_type": "i128"
          }
        }
      ]
    }
  },
