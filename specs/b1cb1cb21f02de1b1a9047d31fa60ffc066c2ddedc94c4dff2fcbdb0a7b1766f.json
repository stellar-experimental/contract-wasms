  {
    "function_v0": {
      "doc": "Admin recapitalisation: `ptokens` USDC pTokens from the admin into the backstop WITHOUT\\nminting shares (a gift to the existing shares). Works in every state an exhausted\\nbackstop can be in: NAV <= 0, Impaired, XLM bad debt outstanding (no NAV read, no oracle).\\nNeeds an existing backstop (shares > 0); the first deposit is the seed (backstop_deposit).\\nClearing Impaired stays admin_resolve_impairment. Returns Bs.ptokens afterwards.",
      "name": "admin_recapitalize",
      "inputs": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "ptokens",
          "type_": "u128"
        }
      ],
      "outputs": [
        "u128"
      ]
    }
  },
