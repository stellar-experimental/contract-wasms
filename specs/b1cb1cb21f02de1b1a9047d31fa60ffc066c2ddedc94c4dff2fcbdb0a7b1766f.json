  {
    "function_v0": {
      "doc": "Long XLM: held XLM, debt USDC. Short XLM: held USDC, debt XLM. `collateral` raw held units\\nfrom the user's wallet; `max_fee` = most USDC (raw) the user accepts for the open fee.\\n\\nLeverage: `debt_usd <= equity_usd * (L - 1)` before the trade (gross notional\\n`equity + debt <= L * equity`), and `notional_usd <= L * equity_usd` after it.\\nOpen fee = `open_fee * (equity_usd + debt_usd)` (the gross notional, known before the\\nswap on both sides), converted to USDC at the oracle.",
      "name": "open",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "held_asset",
          "type_": "address"
        },
        {
