    "function_v0": {
      "doc": "Atomically fund and fill any canonical BLNT V3 interest-auction tier.\\n\\n`max_blnt_in` is required only for XLM and BLNT:XLM bids. It is the\\nexact BLNT intermediate acquired from BLNT:USDC and the maximum BLNT\\nthat the following BLNT:XLM operation may consume. Any unused USDC or\\nBLNT is returned before the pool fill is invoked.",
      "name": "fill_interest",
      "inputs": [
        {
          "doc": "",
          "name": "from",
