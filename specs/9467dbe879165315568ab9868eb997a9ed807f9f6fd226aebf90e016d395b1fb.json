  {
    "function_v0": {
      "doc": "Bookkeeping only: the aggregator has already transferred `amount` of `token` in\\nthe same transaction. Passes only for an allowlisted aggregator that is the direct\\ninvoker. A replayed entry could only come from an allowlisted aggregator whose own\\nconfig.treasury is a different contract, so an aggregator is delisted here before its\\ntreasury is ever repointed (\\xc2\\xa75.8).",
      "name": "credit",
      "inputs": [
        {
          "doc": "",
          "name": "aggregator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "partner",
          "type_": "symbol"
        },
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Swaps treasury-held `token_in` for `token_out` through an allowlisted aggregator,\\npooled per token, with this contract as the fee-exempt user. Keeper only. The\\nkeeper chooses the routes and `min_out`: v3 \\xc2\\xa76.4 states what a stolen key can do.",
      "name": "convert",
      "inputs": [
        {
          "doc": "",
          "name": "aggregator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "min_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "routes",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Route"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
