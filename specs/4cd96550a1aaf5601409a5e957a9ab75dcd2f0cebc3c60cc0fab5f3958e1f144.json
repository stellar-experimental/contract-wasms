    "udt_struct_v0": {
      "doc": "One signed statement about the XDC reserve, submitted by the attestor role.\\nAmounts are XDC in 7-decimal fixed point (the token's own decimals).\\n\\nThe attestation carries the exchange rate explicitly instead of the contract deriving it\\nas reserve \\xc3\\xb7 claims: a deposit into the reserve must create mint headroom (amount up, rate\\nunchanged) while rewards move the rate (rate up, headroom unchanged). The contract\\nenforces solvency (`claims * rate <= amount`) and the per-attestation rate cap, so the\\nattestor's freedom is bounded on both axes.",
      "lib": "",
      "name": "Attestation",
      "fields": [
        {
          "doc": "Reserve including accrued rewards, 7 decimals.",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "The Stellar account that submitted it (must hold the ATTESTOR role).",
          "name": "attestor",
          "type_": "address"
        },
        {
          "doc": "XDC per hstXDC, `RATE_SCALAR` fixed point. Must satisfy solvency and the change cap.",
          "name": "rate",
          "type_": "i128"
        },
        {
          "doc": "XDC-chain address of the reserve (custody address or masternode).",
          "name": "reserve_address",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "state",
          "type_": {
            "udt": {
              "name": "ReserveState"
            }
          }
        },
        {
          "doc": "Unix seconds of the reading. Strictly increasing; never in the future.",
          "name": "timestamp",
          "type_": "u64"
        },
        {
          "doc": "XDC block height the reading was taken at. Strictly increasing.",
          "name": "xdc_block",
          "type_": "u64"
        }
      ]
    }
  },
