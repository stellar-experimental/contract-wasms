  {
    "udt_struct_v0": {
      "doc": "One payment as the account remembers it.\\n\\nWhile the payment counts toward the velocity window, its nonce refuses a\\nreplay of the same challenge and its hashes wait for publish_proof. The\\naccount cannot announce the proof while it authorizes the payment,\\nbecause an x402 facilitator refuses a settlement that emits any event\\nother than the token transfer.",
      "lib": "",
      "name": "PaymentRecord",
      "fields": [
        {
          "doc": "Zero marks an empty slot.",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "challenge_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "This payment reached a velocity limit and froze the account.",
          "name": "froze_account",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "intent_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "merchant_pubkey",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "nonce",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "Its proof of intent has been announced.",
          "name": "published",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "timestamp",
          "type_": "u64"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "What the velocity window looks like at a given moment.",
      "lib": "",
      "name": "VelocityState",
      "fields": [
        {
          "doc": "",
          "name": "total_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "tx_count",
          "type_": "u32"
        },
        {
          "doc": "When the oldest payment still counted was made, or zero if none is.\\nThat payment stops counting at window_start + window_size.",
          "name": "window_start",
          "type_": "u64"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "What the delegated agent presents to settle a payment: its own signature\\nover the Soroban payload, the merchant signature, and the fields both\\nsides claim to have agreed on.\\n\\nThe challenge and intent hashes are deliberately absent. The contract\\nderives them from these fields instead of trusting hashes handed to it,\\nwhich is what makes the merchant signature prove agreement about this\\nexact recipient, asset and amount rather than about an opaque digest.",
      "lib": "",
      "name": "AgentSignature",
      "fields": [
        {
          "doc": "",
          "name": "agent_signature",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "asset",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "expiry",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "merchant_pubkey",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "merchant_signature",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        },
        {
          "doc": "",
          "name": "nonce",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "recipient",
          "type_": "address"
        },
        {
          "doc": "Hash of the HTTP side of the paid request. The endpoint and the body\\nstay off the ledger.",
          "name": "request_digest",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "The spending limits. They can only ever be lowered once the account\\nexists.",
      "lib": "",
      "name": "VelocityConfig",
      "fields": [
        {
          "doc": "The most a single payment may move.",
          "name": "max_payment_amount",
          "type_": "i128"
        },
        {
          "doc": "How much all payments inside one window may add up to.",
          "name": "max_total_amount",
          "type_": "i128"
        },
        {
          "doc": "How many payments may fall inside one window.",
          "name": "max_tx_count",
          "type_": "u32"
        },
        {
          "doc": "The length of the window in seconds. It slides: every payment counts\\nfor exactly this long after it was made.",
          "name": "window_size",
          "type_": "u64"
        }
      ]
    }
  },
  {
    "udt_union_v0": {
      "doc": "The account answers to two different parties, so it accepts two different\\nkinds of proof. Which one applies is decided by what is being authorized,\\nnever by which one the caller happens to supply.\\n\\nThe agent variant is much larger than the owner one. Boxing it is not an\\noption without an allocator, and the value only ever lives for one call.",
      "lib": "",
      "name": "PolicySignature",
      "cases": [
        {
          "tuple_v0": {
            "doc": "",
            "name": "Agent",
            "type_": [
              {
                "udt": {
                  "name": "AgentSignature"
                }
              }
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "Owner",
            "type_": [
              {
                "udt": {
                  "name": "PasskeySignature"
                }
              }
            ]
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A WebAuthn assertion from the owner's passkey. The raw authenticator\\nfields travel to the contract because the signature covers them, and the\\nchallenge the authenticator echoes back is what ties the assertion to a\\nsingle Soroban authorization.",
      "lib": "",
      "name": "PasskeySignature",
      "fields": [
        {
          "doc": "",
          "name": "authenticator_data",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "client_data_json",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "signature",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        }
      ]
    }
  },
