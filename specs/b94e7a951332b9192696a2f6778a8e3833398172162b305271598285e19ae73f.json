                "name": "PolicyError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Move the account's whole balance of a token to the recovery address.\\n\\nThis is the emergency exit. It only works on a frozen account, so it\\nis always the second deliberate step, and the destination was fixed\\nwhen the account was created, so nobody can point it anywhere else.\\nThe delegated signer cannot reach it: it is an owner action, and the\\nagent path only ever authorizes a single agreed transfer.",
      "name": "recover_funds",
      "inputs": [
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "PolicyError"
              }
            }
          }
        }
      ]
    }
  },
