  {
    "function_v0": {
      "doc": "Create the account.\\n\\nEverything that decides where money can go is fixed here and cannot be\\nchanged later: the owner passkey and the domain it belongs to, the\\ntoken the account pays in, and the address the owner can recover the\\nbalance to. The limits can only be lowered afterwards. There is no\\nupgrade path; a different policy means a different account.",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "owner",
          "type_": {
            "bytes_n": {
              "n": 65
            }
          }
        },
        {
          "doc": "",
          "name": "rp_id_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "agent_signer",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "asset",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "recovery",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "velocity_config",
          "type_": {
            "udt": {
              "name": "VelocityConfig"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "PolicyError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Announce the proof of intent for a payment the account authorized.\\n\\nThe content comes from what the account recorded while it verified the\\npayment, not from the caller, so calling this can only ever publish\\nthe truth, and only once.",
      "name": "publish_proof",
      "inputs": [
        {
          "doc": "",
          "name": "nonce",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
