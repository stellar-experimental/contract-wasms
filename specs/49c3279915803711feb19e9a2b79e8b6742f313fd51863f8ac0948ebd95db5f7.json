  {
    "function_v0": {
      "doc": "D19: the owner scans her QR after the job and claims the acres worked, `acres` in hundredths of an\\nacre (27 Oct; were hours), never more than the crop share's own area, using \\xe2\\x89\\xa4 `max_units` centi tractor\\nacres, the units she signed for: her authorisation of (union, token_id, max_units) is used once, its\\nexpiry ledger ~48 h out. The price is the machine type's on the share's crop (its own crop price if the\\nunion set one). Owner split (1 Nov): fund_core pays the prepay (diesel plus the union's share of the\\ndriver part, X32) at once from the voucher's reserve; the rest is postpaid, paid when she repays and by\\nsenior if she defaults.",
      "name": "claim",
      "inputs": [
        {
          "doc": "",
          "name": "owner",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "machine_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "union",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "max_units",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "acres",
          "type_": "u32"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "tuple": {
                "value_types": [
                  "i128",
                  "i128"
                ]
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
