    "udt_struct_v0": {
      "doc": "OZ's `ContextRule`, in full.\\n\\nEvery field is declared even though the interpreter only reads `id`,\\n`signers` and (via the caller) `valid_until`. A `#[contracttype]` struct\\ndecodes from a host map keyed by field name and requires an EXACT field\\nset - a subset raises `Error(Object, UnexpectedSize)` and the call traps\\nbefore any policy logic runs. This type is the wire shape the smart\\naccount sends, not a convenience view of it, so it has to match OZ's\\ndefinition field for field.\\n\\nPinned against `packages/accounts/src/smart_account/storage.rs` in OZ\\nstellar-accounts. `tests/oz_abi.rs` decodes a hand-built map into this\\nstruct so a drift here fails a test rather than only failing on chain.",
      "lib": "",
      "name": "ContextRule",
      "fields": [
        {
          "doc": "",
          "name": "context_type",
          "type_": {
            "udt": {
              "name": "ContextRuleType"
            }
          }
        },
        {
          "doc": "",
          "name": "id",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "name",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "policies",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "policy_ids",
          "type_": {
            "vec": {
              "element_type": "u32"
            }
          }
        },
        {
          "doc": "",
          "name": "signer_ids",
          "type_": {
            "vec": {
              "element_type": "u32"
            }
          }
        },
        {
          "doc": "",
          "name": "signers",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Signer"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "valid_until",
          "type_": {
            "option": {
              "value_type": "u32"
            }
          }
        }
      ]
    }
