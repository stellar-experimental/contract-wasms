  {
    "udt_struct_v0": {
      "doc": "Frozen wire ABI for `Policy::install`'s `AccountParams`.\\n\\n`predicate` is the raw canonical ScVal XDR \\xe2\\x80\\x94 `ScVal::Vec([symbol, ...])`\\nfor the root \\xe2\\x80\\x94 that the encoder emits. The host parses it on receipt; the\\ncontract never touches `stellar-xdr`.",
      "lib": "",
      "name": "PolicyInstallParams",
      "fields": [
        {
          "doc": "",
          "name": "grammar_version",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "install_nonce",
          "type_": "u32"
        },
        {
          "doc": "The Policy Signer role: the set that authorises re-install, uninstall\\nand rotation of this mandate. Appointed explicitly here, under the\\naccount's own authorisation, so it can differ from the rule's signers\\n(the operators). The first install stores it as the master set; a\\nre-install must present the same set, and only\\n`rotate_master_signer_set` may change it.",
          "name": "policy_admins",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Signer"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "predicate",
          "type_": "bytes"
        },
        {
          "doc": "",
