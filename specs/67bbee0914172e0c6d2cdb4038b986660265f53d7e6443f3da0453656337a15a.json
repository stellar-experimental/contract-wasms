    "udt_error_enum_v0": {
      "doc": "",
      "lib": "",
      "name": "PolicyError",
      "cases": [
        {
          "doc": "",
          "name": "ArgMismatch",
          "value": 100
        },
        {
          "doc": "",
          "name": "ContractScope",
          "value": 101
        },
        {
          "doc": "A `call_arg_scaled` operand overflowed `checked_mul`/`checked_div`, or\\nreached the evaluator with a zero denominator. Denies rather than\\npanicking the frame on the arithmetic itself.",
          "name": "ArithmeticOverflow",
          "value": 102
        },
        {
          "doc": "",
          "name": "UnsupportedNode",
          "value": 103
        },
        {
          "doc": "",
          "name": "NotInAllowlist",
          "value": 105
        },
        {
          "doc": "A comparison against a `call_arg_scaled` operand failed. Distinct from\\n`ArgMismatch` so a swap policy's review card can say \"output below the\\nfloor\" rather than \"argument mismatch\".",
          "name": "SlippageFloor",
          "value": 107
        },
        {
          "doc": "",
          "name": "VersionMismatch",
          "value": 200
        },
        {
          "doc": "",
          "name": "MalformedPredicate",
          "value": 201
        },
        {
          "doc": "",
          "name": "NonceReplay",
          "value": 202
        },
        {
          "doc": "",
          "name": "MasterAuthRequired",
          "value": 203
        },
        {
          "doc": "",
          "name": "RuleSignersChanged",
          "value": 204
        },
        {
          "doc": "",
          "name": "MissingState",
          "value": 206
        },
        {
          "doc": "",
          "name": "PredicateTooLarge",
          "value": 207
        },
        {
          "doc": "",
          "name": "PredicateHashMismatch",
          "value": 208
        },
        {
          "doc": "",
          "name": "EmptySignerSet",
          "value": 209
        },
        {
          "doc": "",
          "name": "NoAuthenticatedSigners",
          "value": 210
        },
        {
          "doc": "",
          "name": "ExternalSignerNotSupported",
          "value": 212
        },
        {
          "doc": "A `call_arg_scaled` leaf declared `den == 0`, or a non-positive `num`\\nor `den`. A zero denominator would divide by zero at evaluate; a\\nnegative ratio silently INVERTS the comparison, so a floor written as\\n`call_arg >= call_arg_scaled(in, -1, 100)` would permit exactly the\\ntrades it was meant to refuse. Refused at install so the mistake is\\nloud once rather than silent forever.",
          "name": "InvalidScaledRatio",
          "value": 214
        },
        {
          "doc": "Predicate carries no selector leaf - literals on both sides of every\\ncompare, no `call_contract`/`call_fn`/`call_arg`/`now`. Such a\\npredicate is either trivially true or trivially false at install\\ntime, so it permits everything or nothing forever. Refused at\\ninstall.",
          "name": "SelectorLeafRequired",
          "value": 216
        },
        {
          "doc": "Master signer set exceeded `MAX_SIGNERS`. Re-hashed on every permit\\nand one `require_auth` per signer; an unbounded set pushes `enforce`\\npast the CPU budget and bricks the rule.",
          "name": "TooManySigners",
          "value": 217
        },
        {
          "doc": "The context rule is `Default`-scoped. That scope matches every\\noperation on the account, including its own administration\\n(`add_context_rule` and friends), so the predicate would be the only\\nfence around the admin surface and a weakened predicate would hand\\nthe rule's operators the whole account. Predicates install on scoped\\nrules only.",
          "name": "DefaultContextNotSupported",
          "value": 218
        }
      ]
    }
  },
