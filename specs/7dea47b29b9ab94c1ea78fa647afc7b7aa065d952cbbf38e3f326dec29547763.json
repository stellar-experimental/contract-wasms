      "name": "assets",
      "inputs": [],
      "outputs": [
        {
          "vec": {
            "element_type": "address"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Add liquidity to `asset`'s pool at its current ratio. Anyone can.\\n`hitz` is exact; the matching amount of the asset (rounded up, in the\\nvault's favour) must land in `[min_amount, max_amount]`, which bounds\\nthe price the deposit accepts so it can't be sandwiched. No shares, no\\nwithdrawal. The price doesn't move, so the pool's deviation doesn't\\neither.",
      "name": "deposit",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "asset",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "hitz",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "max_amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Install the proposed code once the 7 days have passed.",
      "name": "upgrade",
