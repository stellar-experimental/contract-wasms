  {
    "function_v0": {
      "doc": "One-time initial liquidity for `asset`'s pool, by the admin, at the\\nasset's market price: `amount / hitz` is the pool's starting price.\\nThe pool's deviation starts at the HITZ-weighted average of the other\\npools' deviations, so a recent HITZ move that every pool already shows\\nisn't read as a dislocation of the new asset.",
      "name": "seed",
      "inputs": [
        {
          "doc": "",
          "name": "asset",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "hitz",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Swap an exact `amount_in` of `token_in` for at least `min_out` of\\n`token_out`, paid to `to`. Any listed asset trades with HITZ (one hop)\\nand with any other listed asset (two hops, through HITZ). Expiry comes\\nfrom the transaction's own time bounds.",
      "name": "swap",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "to",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_out",
          "type_": "i128"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "The admin, or `None` once renounced.",
      "name": "admin",
      "inputs": [],
      "outputs": [
        {
          "option": {
            "value_type": "address"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
