    "function_v0": {
      "doc": "The vault's exchange rate: how much `quote` one unit of `base` is\\nworth, from the two pools (9 decimals, raw token units).",
      "name": "rate",
      "inputs": [
        {
          "doc": "",
          "name": "base",
          "type_": "address"
