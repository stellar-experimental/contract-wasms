  {
    "udt_enum_v0": {
      "doc": "Roles, mirroring the separation of duties from the EVM deployment.",
      "lib": "",
      "name": "Role",
      "cases": [
        {
          "doc": "Configuration, token allowlist, role management, unpause.",
          "name": "Admin",
          "value": 0
        },
        {
          "doc": "Authorises WASM upgrades. Held apart from settlement.",
          "name": "Upgrader",
          "value": 1
        },
        {
          "doc": "Emergency stop. Unpausing is Admin-only by design.",
          "name": "Pauser",
          "value": 2
        },
        {
          "doc": "Settles and refunds orders.",
          "name": "Aggregator",
          "value": 3
        },
        {
          "doc": "Creates orders on a user's behalf (relayed flow).",
          "name": "OrderCreator",
          "value": 4
        },
        {
          "doc": "Moves house float in and out.",
          "name": "Treasurer",
          "value": 5
        }
      ]
    }
  },
