  {
    "udt_enum_v0": {
      "doc": "Direction of the ramp.\\n\\n`OnRamp` is fiat -> crypto: the user pays fiat off-chain and receives tokens.\\n`OffRamp` is crypto -> fiat: the user escrows tokens and receives fiat off-chain.",
      "lib": "",
      "name": "OrderType",
      "cases": [
        {
          "doc": "",
          "name": "OnRamp",
          "value": 0
        },
        {
          "doc": "",
          "name": "OffRamp",
          "value": 1
        }
      ]
    }
  },
  {
    "udt_enum_v0": {
      "doc": "Lifecycle of an order. `Settled` and `Refunded` are terminal; there is no path out of\\neither. Absence of a stored record is the \"does not exist\" state, so unlike the EVM\\nport there is no `None` sentinel to model.",
      "lib": "",
      "name": "OrderStatus",
      "cases": [
        {
          "doc": "",
          "name": "Pending",
          "value": 0
        },
        {
          "doc": "",
          "name": "Settled",
          "value": 1
        },
        {
          "doc": "",
          "name": "Refunded",
          "value": 2
        }
      ]
    }
  },
