  {
    "function_v0": {
      "doc": "Delivers the net amount to the beneficiary and the fee to the fee recipient.\\n\\nPanics on any failure so the manager's settlement unwinds atomically. The manager\\nindependently verifies the beneficiary's balance delta afterwards, so this\\nadapter's cooperation is checked, not assumed.",
      "name": "settle_on_ramp",
      "inputs": [
        {
          "doc": "",
          "name": "ctx",
          "type_": {
            "udt": {
              "name": "OrderContext"
            }
          }
        },
        {
          "doc": "",
          "name": "beneficiary",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "fee_recipient",
          "type_": "address"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "The manager has already transferred `ctx.net_amount` in. For the in-house pool the\\noff-ramp proceeds simply become on-ramp float, so there is nothing to do beyond\\nrecording it \\xe2\\x80\\x94 a partner adapter would kick off the fiat payout here.",
      "name": "settle_off_ramp",
      "inputs": [
        {
          "doc": "",
          "name": "ctx",
          "type_": {
            "udt": {
              "name": "OrderContext"
            }
          }
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Pre-flights liquidity so an on-ramp order is rejected at creation time rather than\\nat settlement, when the user is already waiting on a fiat leg they have paid.",
