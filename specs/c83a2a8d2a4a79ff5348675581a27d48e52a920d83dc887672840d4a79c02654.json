  {
    "function_v0": {
      "doc": "Permissionless: advances the global yield index to `INDEX_SCALE * SCALE / oracle_rate`.\\nNo-op if the rate hasn't increased since the last recorded high-water mark, matching\\nthe protocol-wide invariant that YT never accrues negative yield. Because the index is a\\nclosed form of the current rate, the number of intermediate calls cannot change any\\nholder's total -- see this module's doc comment.",
      "name": "update_yield_index",
      "inputs": [],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "The current yield index `INDEX_SCALE * SCALE / rate` (see module docs) -- it only ever\\ndecreases as the oracle rate rises. Meaningful relative to an account's own\\n`last_claimed_index`.",
      "name": "accrued_yield_index",
      "inputs": [],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "One-time wiring of the RecoveryEscrow contract authorized to call `seize`. Settable once,\\nnever reassigned -- so an admin mistake here (wrong address, a stale address copied from a\\ndifferent market) would otherwise be permanent. Mirroring `PrincipalManager::initialize`'s\\n`assert_topology_matches` and `RecoveryEscrow::initialize`'s own cross-check of every\\nposition's `underlying_address()`, this calls back into the given address and requires its\\nown `underlying_address()` to match this token's underlying before accepting it. Found\\nduring audit review.",
      "name": "set_recovery_escrow",
      "inputs": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "escrow",
          "type_": "address"
        }
      ],
      "outputs": []
    }
