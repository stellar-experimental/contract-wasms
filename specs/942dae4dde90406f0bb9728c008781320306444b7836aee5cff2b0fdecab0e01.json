  {
    "udt_struct_v0": {
      "doc": "What the payer signs: `execute_send` with the intent alone, and below it the pull of `amount_ld + fee`. The\\nhost's auth nonce stops a replay of the signed entry, and its `signature_expiration_ledger` ends it.",
      "lib": "",
      "name": "Intent",
      "fields": [
        {
          "doc": "Bridged, in the token's 7 decimals: a multiple of the route's conversion rate.",
          "name": "amount_ld",
          "type_": "i128"
        },
        {
          "doc": "The recipient on the destination: an EVM address left-padded, or a 32-byte account.",
          "name": "beneficiary",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "The destination's LayerZero endpoint id.",
          "name": "dst_eid",
          "type_": "u32"
        },
        {
          "doc": "keccak256 of the executor options, as on EVM. v1 sends none: keccak256 of nothing.",
          "name": "extra_options_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "EEL's fee in the token, to the treasury.",
          "name": "fee",
          "type_": "i128"
        },
        {
          "doc": "The floor on the destination.",
          "name": "min_amount_ld",
          "type_": "i128"
        },
        {
          "doc": "The OFT the route allows for the token.",
          "name": "oft",
          "type_": "address"
        },
        {
          "doc": "Signs, and pays the amount and the fee.",
          "name": "payer",
          "type_": "address"
        },
        {
          "doc": "So identical intents get distinct ids.",
          "name": "salt",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "USDT0's asset contract.",
          "name": "token",
          "type_": "address"
        }
      ]
    }
  }
