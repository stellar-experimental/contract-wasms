  {
    "udt_struct_v0": {
      "doc": "What a send through an OFT needs, read from the OFT once, when the owner allows it.",
      "lib": "",
      "name": "Route",
      "fields": [
        {
          "doc": "10^(token decimals - shared decimals). An amount is a multiple of it.",
          "name": "conversion_rate",
          "type_": "i128"
        },
        {
          "doc": "The OFT's LayerZero endpoint, which the router pays the fee to.",
          "name": "endpoint",
          "type_": "address"
        },
        {
          "doc": "The endpoint's fee token: XLM's asset contract.",
          "name": "native_token",
          "type_": "address"
        },
        {
          "doc": "The OFT's token: USDT0's asset contract.",
          "name": "token",
          "type_": "address"
        }
      ]
    }
  },
  {
    "udt_error_enum_v0": {
      "doc": "Every refusal, by its number. A refused call moves nothing.",
      "lib": "",
      "name": "RouterError",
      "cases": [
        {
          "doc": "Only the owner may do this.",
          "name": "NotOwner",
          "value": 1
        },
        {
          "doc": "The pauser may pause and drop a relayer, and nothing else.",
          "name": "NotPauser",
          "value": 2
        },
        {
          "doc": "",
          "name": "NotRelayer",
          "value": 3
        },
        {
          "doc": "",
          "name": "Paused",
          "value": 4
        },
        {
          "doc": "No route for the intent's OFT, or the route's token is another.",
          "name": "RouteNotAllowed",
          "value": 5
        },
        {
          "doc": "`set_route`: the OFT's token is another.",
          "name": "OftTokenMismatch",
          "value": 6
        },
        {
          "doc": "`set_route`: the OFT doesn't burn what it sends, so the router can't authorize its debit.",
          "name": "UnsupportedOft",
          "value": 7
        },
        {
          "doc": "A negative fee or floor, an amount of zero, or a sum that overflows.",
          "name": "InvalidAmount",
          "value": 8
        },
        {
          "doc": "The amount isn't a multiple of the OFT's conversion rate: the rest couldn't cross.",
          "name": "AmountHasDust",
          "value": 9
        },
        {
          "doc": "The intent signs executor options, which v1 never sends.",
          "name": "ExtraOptionsMismatch",
          "value": 10
        },
        {
          "doc": "The router's balance of the token or of the fee token changed.",
          "name": "RouterBalanceChanged",
          "value": 11
        }
      ]
    }
  },
