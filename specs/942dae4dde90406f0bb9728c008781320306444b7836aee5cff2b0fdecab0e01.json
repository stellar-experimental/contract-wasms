  {
    "function_v0": {
      "doc": "Pull `amount_ld + fee` from the payer, pay the fee, bridge `amount_ld`. Returns the LayerZero guid.\\n\\n- `relayer`: on the list, authorizes the call and pays `native_fee` in XLM. The endpoint refunds it what the\\nfee leaves over.\\n- `native_fee`: LayerZero's fee in stroops, from the OFT's `quote_send` with the router as `from`.",
      "name": "execute_send",
      "inputs": [
        {
          "doc": "",
          "name": "relayer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "intent",
          "type_": {
            "udt": {
              "name": "Intent"
            }
          }
        },
        {
          "doc": "",
          "name": "native_fee",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "bytes_n": {
            "n": 32
          }
        }
      ]
    }
  },
