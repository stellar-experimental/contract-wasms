          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "expiry_seconds",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u64",
            "error_type": "error"
          }
        }
      ]
    }
  },
