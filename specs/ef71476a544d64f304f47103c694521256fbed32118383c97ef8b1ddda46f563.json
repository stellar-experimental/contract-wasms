  {
    "function_v0": {
      "doc": "Set or rotate the ed25519 key whose signatures `register_receipt`\\naccepts. Admin only. Pass the raw 32 bytes of TIA's receipt key\\n(the `G\\xe2\\x80\\xa6` in `TIA_RECEIPT_SECRET`'s public half, decoded).",
      "name": "set_receipt_signer",
      "inputs": [
        {
          "doc": "",
          "name": "signer",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "tuple": {
                "value_types": []
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Anchor a signed TIA receipt on Stellar.\\n\\n* `submitter` must authorize the call (it pays the fee and is recorded).\\n* `cid` must look like an IPFS CID.\\n* `receipt_hash` must not be registered yet.\\n* `signature` must be TIA's ed25519 signature over\\n`nirium-audit-v1:<hex(receipt_hash)>`; the contract verifies it with\\nthe configured signer key and traps if it does not match.\\n\\nStores the record, bumps the counter, emits\\n`(\"receipt\", receipt_hash) -> (id, cid, submitter)` and returns the id.",
      "name": "register_receipt",
      "inputs": [
        {
          "doc": "",
          "name": "submitter",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "receipt_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "cid",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "signature",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u64",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Read a registered receipt by its sha256. `None` if it was never registered.",
      "name": "get_receipt",
