  {
    "function_v0": {
      "doc": "Lock `amount` of the configured USDC SAC from `sender`.\\nThe contract assigns the reservation id from an instance counter.\\n`merchant` is bound to the reservation and is the only merchant that\\ncan later cash it out. `expiry_seconds` must sit between\\n`MIN_EXPIRY_SECONDS` (1 hour) and `MAX_EXPIRY_SECONDS` (30 days).\\nThe reservation stores the resulting ledger timestamp in `expires_at`.",
      "name": "initialize_reservation",
      "inputs": [
        {
          "doc": "",
          "name": "sender",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "receiver",
          "type_": "address"
        },
        {
          "doc": "",
