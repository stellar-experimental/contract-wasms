  {
    "function_v0": {
      "doc": "Creates a strategy and pulls `amount_per_order * orders_total` worth\\nof `sell_asset` from `owner` into the contract's own balance, plus the\\nupfront fee straight to `treasury`. These are plain `transfer`s out of\\n`owner`, so no prior `approve` is needed: the owner's single signature\\non this call authorizes exactly those two transfers (Soroban auth\\nentries cover the nested token calls).",
      "name": "create_strategy",
      "inputs": [
        {
          "doc": "",
          "name": "owner",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "sell_asset",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "buy_asset",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_per_order",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "orders_total",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "interval_seconds",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u64",
            "error_type": {
              "udt": {
                "name": "DcaError"
              }
            }
          }
        }
      ]
    }
  },
