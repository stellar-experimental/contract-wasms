    "function_v0": {
      "doc": "Owner-only: pull back whatever budget hasn't been swapped yet.\\nNo co-signer dance, no account-merge \\xe2\\x80\\x94 this is the Soroban\\nequivalent of the Stellar \"Withdraw & close\" flow.",
      "name": "withdraw_remaining",
