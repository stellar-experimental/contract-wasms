  {
    "function_v0": {
      "doc": "Only the keeper can call this, and it can only ever do exactly what's\\nbaked into this function: swap this strategy's fixed `amount_per_order`\\nthrough the router and send the proceeds straight to `owner` \\xe2\\x80\\x94 the\\ncontract never custodies the swap output. `min_amount_out` is computed\\noff-chain by the bot (reference price minus a slippage tolerance) and\\nre-checked here implicitly: the router call reverts if it can't meet it.",
      "name": "execute_order",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "min_amount_out",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "DcaError"
              }
            }
          }
        }
      ]
    }
  },
