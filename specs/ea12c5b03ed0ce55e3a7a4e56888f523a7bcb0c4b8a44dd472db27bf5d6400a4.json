  {
    "function_v0": {
      "doc": "Zero-capital atomic Blend v2 user liquidation auction filler (`L=65589583` / `L=65589703`).\\n\\nSupports both Mode A (`flash_token == bid_token`: flash debt -> fill auction -> swap collateral\\nback to debt -> repay) and Mode B (`flash_token == lot_token`: flash collateral -> swap to debt ->\\nfill auction -> repay). Atomically reverts if net profit does not clear `out_min > flash_amt`.",
      "name": "flash_liq",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "exec",
          "type_": "address"
        },
