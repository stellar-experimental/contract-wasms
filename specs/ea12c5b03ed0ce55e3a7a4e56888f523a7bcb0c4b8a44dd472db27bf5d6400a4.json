          "type_": "u128"
        },
        {
          "doc": "",
          "name": "spec",
          "type_": {
            "udt": {
              "name": "LiqSpec"
            }
          }
        },
        {
          "doc": "",
          "name": "branches",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Branch"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "out_min",
          "type_": "u128"
        },
        {
          "doc": "",
          "name": "mutex_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        "u128"
      ]
    }
