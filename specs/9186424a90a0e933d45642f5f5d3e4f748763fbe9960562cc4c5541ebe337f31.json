  {
    "udt_union_v0": {
      "doc": "Job lifecycle. `Released` and `Settled` are terminal \\xe2\\x80\\x94 and that is the\\nentire point of the product.",
      "lib": "",
      "name": "State",
      "cases": [
        {
          "void_v0": {
            "doc": "Funded, awaiting delivery.",
            "name": "Open"
          }
        },
        {
          "void_v0": {
            "doc": "Terminal. Funds moved to the freelancer and are not recoverable.",
            "name": "Released"
          }
        },
        {
          "void_v0": {
            "doc": "The client has posted a bond to contest delivery.",
            "name": "Challenged"
          }
        },
        {
          "void_v0": {
            "doc": "Terminal. A challenge was resolved.",
            "name": "Settled"
          }
        }
