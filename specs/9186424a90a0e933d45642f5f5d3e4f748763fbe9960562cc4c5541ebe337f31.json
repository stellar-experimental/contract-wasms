  {
    "function_v0": {
      "doc": "Contest delivery. The client posts a bond proportional to the amount.\\n\\nThis is where the invariant lives: a job that has already released is not\\n`Open`, so it cannot be challenged, and no other entry point moves funds\\nout of a released job. Money that cleared a verified release is gone.",
      "name": "challenge",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
