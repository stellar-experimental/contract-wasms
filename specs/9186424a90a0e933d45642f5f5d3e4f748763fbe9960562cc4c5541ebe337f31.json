  {
    "function_v0": {
      "doc": "Sweep a job where nothing was ever delivered. The client's money returns\\nand the freelancer's stake is forfeited. Thirty seconds, not fourteen\\ndays.",
      "name": "expire",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Submit the delivered artifact.\\n\\nA matching artifact settles **inside this same transaction**, whether or\\nnot a challenge is already open: verification outranks adjudication,\\nbecause there is nothing left to adjudicate. An unmatched artifact leaves\\nthe job open for the client to contest.\\n\\nThere is no window in which approved work can be charged back \\xe2\\x80\\x94 that\\nabsence is the product.",
      "name": "submit",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "artifact_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Resolve a challenge. Fully deterministic and fully on-chain: the contract\\ncompares the artifact the freelancer submitted against the commitment the\\nclient signed at funding. No external input decides this.",
      "name": "confirm",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": []
    }
  },
