  {
    "udt_enum_v0": {
      "doc": "Lifecycle of a single milestone.\\n\\nEvery transition out of this enum requires a signature from a specific human\\nrole. There is no transition that any automated party \\xe2\\x80\\x94 including the\\nadvisory review module \\xe2\\x80\\x94 can trigger on its own.",
      "lib": "",
      "name": "MilestoneStatus",
      "cases": [
        {
          "doc": "Funded and waiting on the builder.",
          "name": "Pending",
          "value": 0
        },
        {
          "doc": "Builder submitted evidence; waiting on the reviewer.",
          "name": "EvidenceSubmitted",
          "value": 1
        },
        {
          "doc": "Reviewer approved. Funds are still in escrow until `release`.",
          "name": "Approved",
          "value": 2
        },
        {
          "doc": "Reviewer asked for revision. Builder may resubmit.",
          "name": "Held",
          "value": 3
        },
        {
          "doc": "Terminal. USDC has moved to the builder.",
          "name": "Released",
          "value": 4
        },
        {
          "doc": "Terminal. USDC has moved back to the sponsor after the deadline.",
          "name": "Refunded",
          "value": 5
        }
      ]
    }
  },
