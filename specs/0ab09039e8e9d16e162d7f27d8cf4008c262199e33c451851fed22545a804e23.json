  {
    "function_v0": {
      "doc": "Authorise another wallet to decide payouts on this engagement.\\n\\nOnly the sponsor may call this. The builder is refused however the call\\nis dressed up: a builder who could approve would sign off their own work\\nand release their own payment, and that is the one collision this\\ncontract will not allow at any point in an engagement's life.",
      "name": "add_reviewer",
      "inputs": [
        {
          "doc": "",
          "name": "engagement_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "who",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Pin the settlement asset once, at deploy time.\\n\\nDeliberately not re-callable: if the token could be swapped later, an\\nengagement funded in USDC could be released in something worthless.\\n`first_id` starts the engagement counter above whatever the previous\\ndeployment reached, so an id names exactly one engagement across both and\\na link written against the old contract never resolves to a new one.",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "first_id",
          "type_": "u64"
        }
      ],
      "outputs": []
    }
  },
