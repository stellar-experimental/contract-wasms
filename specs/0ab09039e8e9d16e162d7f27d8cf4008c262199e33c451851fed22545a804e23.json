    "function_v0": {
      "doc": "Define an engagement and its milestones. Does not move funds \\xe2\\x80\\x94 see `fund`.\\n\\nThe sponsor signs, and by signing becomes the account that decides every\\npayout. `reviewers` is who else may \\xe2\\x80\\x94 it can be empty, and the sponsor can\\nchange it later with `add_reviewer` and `remove_reviewer`.",
      "name": "create_engagement",
      "inputs": [
        {
          "doc": "",
          "name": "sponsor",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "builder",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "reviewers",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "milestones",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "MilestoneInput"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u64",
            "error_type": "error"
          }
        }
      ]
    }
  },
