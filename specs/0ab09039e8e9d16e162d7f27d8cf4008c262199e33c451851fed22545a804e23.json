[
  {
    "function_v0": {
      "doc": "Move the full milestone total into escrow.\\n\\nAll-or-nothing on purpose: partial funding would let a sponsor advertise\\nthree milestones while only backing one, which is exactly the ambiguity\\nSprintOS exists to remove.",
      "name": "fund",
      "inputs": [
        {
          "doc": "",
          "name": "engagement_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
