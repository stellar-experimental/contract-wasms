  {
    "function_v0": {
      "doc": "Creates a token on terms that can never change after this, and makes its Soroswap pair. `first_buy` XLM beyond the\\nlaunch fee is the creator's own first buy, in the same transaction, and it never pays the anti-snipe rate.\\n`whole_supply` is in whole coins, zero for the default billion. `dev_fee_bps` is the creator's fee on top of the 1%,\\nup to 10%; of it, `holders_bps` goes to holders and `burn_bps` buys back and burns, and the creator gets the rest.\\n`max_wallet_bps` (100 to 500, a share of the supply) and `max_wallet_secs` (900 to 86,400) set a max wallet for that\\nlong after launch, both zero for none; the first buy has to fit under it.",
      "name": "launch",
      "inputs": [
        {
          "doc": "",
          "name": "creator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "name",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "symbol",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "uri",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "whole_supply",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "dev_fee_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "holders_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "burn_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "anti_snipe",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "first_buy",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_tokens_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "max_wallet_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "max_wallet_secs",
          "type_": "u64"
        }
      ],
      "outputs": [
        "address"
      ]
    }
  },
