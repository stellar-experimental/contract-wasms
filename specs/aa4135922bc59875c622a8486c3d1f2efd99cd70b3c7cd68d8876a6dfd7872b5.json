    "function_v0": {
      "doc": "Creates an order.\\n\\n`creator` is whoever submits the transaction; `requester` is the beneficiary. A\\nrelayer may create on a user's behalf only if it holds [`Role::OrderCreator`].\\n\\nFor off-ramp orders the requester's authorisation is required explicitly, binding\\ntheir intent at the order level rather than relying solely on the token transfer's\\nown auth check. `intent_key` makes the order id deterministic, which gives the\\ncontract true idempotency: replaying an intent is rejected rather than creating a\\nsecond payable order.",
      "name": "create_order",
      "inputs": [
        {
          "doc": "",
          "name": "creator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "requester",
          "type_": "address"
