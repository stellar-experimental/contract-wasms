    "function_v0": {
      "doc": "Replaces this contract's WASM. Restricted to [`Role::Upgrader`].\\n\\nStellar upgrades in place: the contract address, its storage and its balances are\\nuntouched, and only the executable changes. That removes the entire class of\\nproxy-related failure the EVM design has to defend against \\xe2\\x80\\x94 no delegatecall, no\\nimplementation slot to hijack, no storage-layout compatibility to verify.\\n\\nWhat it does *not* remove is the need to keep storage readable: if a new WASM\\nchanges the shape of a stored type, existing entries will fail to decode. Bump\\n[`STORAGE_VERSION`] and migrate deliberately when that happens.",
      "name": "upgrade",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "new_wasm_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
