  {
    "udt_struct_v0": {
      "doc": "",
      "lib": "",
      "name": "Quote",
      "fields": [
        {
          "doc": "Whether the forwarder will create the recipient's token account (forward path only).",
          "name": "account_created",
          "type_": "bool"
        },
        {
          "doc": "The part of `fee` that is the destination account's rent, broken out so the UI can say\\nwhat it is for rather than showing one unexplained number. Always zero when forwarded.",
          "name": "account_fee",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "Everything the user pays besides the principal: on the relay path the percentage-or-floor\\npart plus the account fee if it applies; on the forward path `max(that, forward_fee)`. The\\nrecipient always receives `amount - fee - remainder`.",
          "name": "fee",
          "type_": "i128"
        },
        {
          "doc": "Circle's forward fee: the `max_fee` charged to the recipient at the mint, in full. Zero on\\nthe relay path.",
          "name": "forward_fee",
          "type_": "i128"
        },
        {
          "doc": "Whether this transfer takes the forward path.",
          "name": "forwarded",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "net_burned",
          "type_": "i128"
        },
        {
          "doc": "The sub-10-stroop remainder that is never transferred out of the user's wallet.",
          "name": "remainder",
          "type_": "i128"
        },
        {
          "doc": "The part of `fee` this contract keeps: `fee - forward_fee`. The only thing pulled from the\\nuser besides the burn, and the only thing that accrues.",
          "name": "wrapper_take",
          "type_": "i128"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "",
      "lib": "",
      "name": "Params",
      "fields": [
        {
          "doc": "Charged on top of the percentage fee when the destination has no token account yet.\\n\\nCreating one on Solana costs about 2,039,280 lamports of rent that **nobody can ever\\nreclaim** \\xe2\\x80\\x94 closing the account needs the owner's signature, which a sponsor does not\\nhave. Folding that into `min_fee` would make every transfer pay for a cost only\\nfirst-time recipients incur, which is what forced the floor up to a level that made small\\ntransfers unattractive. Charged separately, the floor can stay low.\\n\\nThe price is set here, by the admin, rather than supplied by the caller. The caller only\\nsays *whether* it applies.",
          "name": "account_fee",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "fee_bps",
          "type_": "u32"
        },
        {
          "doc": "Ceiling on the Circle fee allowance a caller may request, in bps of `net`.",
          "name": "max_cctp_fee_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "max_transfer",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_fee",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_transfer",
          "type_": "i128"
        }
      ]
    }
  },
