  {
    "udt_struct_v0": {
      "doc": "A follower's limits for one leader. Amounts in stroops of XLM.",
      "lib": "",
      "name": "Rules",
      "fields": [
        {
          "doc": "Copy only the first buy of each token.",
          "name": "buy_once",
          "type_": "bool"
        },
        {
          "doc": "How much worse than the leader's own price a copy may still go in at, or come out at.",
          "name": "chase_bps",
          "type_": "u32"
        },
        {
          "doc": "Sell along with the leader.",
          "name": "copy_sells",
          "type_": "bool"
        },
        {
          "doc": "Only tokens younger than this many seconds. Zero for any. Daily's own tokens only when set.",
          "name": "max_age",
          "type_": "u64"
        },
        {
          "doc": "A copied sale never fetches less than this share of what the tokens cost.",
          "name": "min_sell_bps",
          "type_": "u32"
        },
        {
          "doc": "Most XLM copies of this leader may cost in a day (UTC): the buys, their run fees and the copy fee. Zero for no limit.",
          "name": "per_day",
          "type_": "i128"
        },
        {
          "doc": "Most XLM copied into one token from this leader over time. Zero for no limit.",
          "name": "per_token",
          "type_": "i128"
        },
        {
          "doc": "Most XLM one copied buy may spend.",
          "name": "per_trade",
          "type_": "i128"
        },
        {
          "doc": "The leader's own size times this, before the limits. 10,000 copies the same size.",
          "name": "size_bps",
          "type_": "u32"
        },
        {
          "doc": "How far the trade itself may slip from the quote at the moment of copying.",
          "name": "slippage_bps",
          "type_": "u32"
        }
      ]
    }
  },
