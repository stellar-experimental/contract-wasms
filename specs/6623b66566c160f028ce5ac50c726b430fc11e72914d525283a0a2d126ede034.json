  {
    "udt_error_enum_v0": {
      "doc": "Soroban equivalent of `ZebecCardError`.\\n\\nAn invalid ed25519 signature is not listed here: `env.crypto().ed25519_verify`\\ntraps the host directly, which reverts the whole invocation.",
      "lib": "",
      "name": "CardError",
      "cases": [
        {
          "doc": "The provided index is not `current_index + 1`.",
          "name": "InvalidIndex",
          "value": 1
        },
        {
          "doc": "The provided token is invalid (e.g. swapping from USDC to USDC).",
          "name": "InvalidToken",
          "value": 2
        },
        {
          "doc": "The amount entered is invalid.",
          "name": "InvalidAmount",
          "value": 3
        },
        {
          "doc": "The user does not have enough USDC balance.",
          "name": "NotEnoughBalance",
          "value": 4
        },
        {
          "doc": "Amount falls off the min-max card buy range.",
          "name": "AmountNotWithinCardBuyRange",
          "value": 5
        },
        {
          "doc": "Card buy limit exceeded for the day.",
          "name": "DailyBuyLimitExceeded",
          "value": 6
        },
        {
          "doc": "The swap produced zero or negative USDC for this contract.",
          "name": "FaultySwappedAmount",
          "value": 7
        },
        {
          "doc": "The backend fee signature has expired.",
          "name": "SignatureExpired",
          "value": 8
        },
        {
          "doc": "The configuration is invalid (negative daily limit, overlapping tiers, ...).",
          "name": "InvalidConfig",
          "value": 9
        },
        {
          "doc": "A fee value is outside `[0, 10_000]` bps.",
          "name": "InvalidFee",
          "value": 10
        },
        {
          "doc": "The swap route is malformed (wrong hops, wrong output token, ...).",
          "name": "InvalidRoute",
          "value": 11
        },
        {
          "doc": "The requested swap venue is not configured / enabled by the admin.",
          "name": "SwapVenueDisabled",
          "value": 12
        },
        {
          "doc": "A Soroswap aggregator leg uses a protocol that this contract does not support.",
          "name": "UnsupportedProtocol",
          "value": 13
        },
        {
          "doc": "The swap venue did not consume exactly `amount_in` of the source token.",
          "name": "SwapInputMismatch",
          "value": 14
        },
        {
          "doc": "The swap produced less USDC than `min_usdc_out`.",
          "name": "SlippageExceeded",
          "value": 15
        },
        {
          "doc": "Arithmetic overflow / underflow.",
          "name": "ArithmeticError",
          "value": 16
        }
      ]
    }
