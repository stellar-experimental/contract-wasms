  {
    "function_v0": {
      "doc": "Set up a recurring remittance of `amount` to `to` every `interval`\\nseconds, `runs` times. The first run is due right away. Funds are\\npulled from `from`'s allowance on the token, so `from` must approve\\nthis contract for what all their open schedules still need (SEP-41\\napprove replaces the allowance; the API sums it). The interval is 1\\nminute to 92 days and the last run is at most 170 days after the\\nfirst, so one allowance can fund it. Returns the schedule id.",
      "name": "create_schedule",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "to",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "interval",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "runs",
          "type_": "u32"
        }
      ],
      "outputs": [
        "u64"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Move `amount` of the caller's own USDC from their wallet into their\\nsavings, on top of what remittances already saved. Respects the\\nper-recipient cap and the pause switch. Returns the new savings total.",
      "name": "deposit_savings",
      "inputs": [
