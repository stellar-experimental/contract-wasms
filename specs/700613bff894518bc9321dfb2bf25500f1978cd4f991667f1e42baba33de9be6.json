    "function_v0": {
      "doc": "Set aside `amount` for `beneficiary` to spend only on `payee` (school\\nfees, a clinic, rent). The funds leave the sender now and wait here,\\napart from anyone's savings. It can stay open up to 100 days, and\\nduring the beta the open pledges one beneficiary decides on are capped\\nat the per-person cap. Returns the pledge id.",
      "name": "create_pledge",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
