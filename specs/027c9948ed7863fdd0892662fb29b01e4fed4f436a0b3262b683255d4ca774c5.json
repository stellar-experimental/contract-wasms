    }
  },
  {
    "function_v0": {
      "doc": "Pulls `amount` from the allowlisted `from`, forwards it to the upstream and mints floor\\nshares on the measured NAV delta (not on `amount`), so the upstream's rounding is borne by\\nthe depositor.",
      "name": "deposit",
      "inputs": [
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
