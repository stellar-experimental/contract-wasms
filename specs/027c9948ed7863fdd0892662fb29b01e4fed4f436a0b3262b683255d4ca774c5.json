                "name": "StrategyError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Keeper-only (dual check). Yield is the upstream share price: nothing to claim, so this\\nrefreshes `LastNav` (when the read succeeds) and emits the event. Never reverts on a failed\\nread. `data` is ignored.",
      "name": "harvest",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "data",
          "type_": {
            "option": {
              "value_type": "bytes"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "StrategyError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Pays `amount` to `to` straight from the upstream. Never allowlist-gated. Needs a live NAV\\nread (`ExternalError` otherwise). Fails\\n`InsufficientBalance` (nothing moved) above the vault's balance or the upstream's instant\\nliquidity; an upstream refusal after that is `ExternalError` and reverts everything.",
      "name": "withdraw",
      "inputs": [
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "from",
