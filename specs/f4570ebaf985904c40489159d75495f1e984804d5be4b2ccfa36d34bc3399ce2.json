  {
    "function_v0": {
      "doc": "An investor's owed interest (rupees, from their exit) paid in USDC by a member LP of the union: the LP\\ntakes `inr` rupees at the office and pays `usdc` straight to the investor, at least the fix less the\\nLP fee. A leader of the union (who hands over the notes) and the LP sign. fund_core burns the nIN and\\nbooks the rupees off cash at hand. The LP's Nila account pays from its free USDC (`send_usdc`), so an\\nopen lien does not stop it. No USDC of this contract moves. Returns what cash at hand covered.",
      "name": "pay_income",
      "inputs": [
        {
          "doc": "",
          "name": "union",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "investor",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "leader",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "lp",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "inr",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "usdc",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
