  {
    "udt_error_enum_v0": {
      "doc": "",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "No envelope (or keep asset) at that key.",
          "name": "NotFound",
          "value": 1
        },
        {
          "doc": "The envelope was already claimed or returned.",
          "name": "NotOpen",
          "value": 2
        },
        {
          "doc": "Reserved. A claim's signature is checked by the host, which aborts on a bad one before\\nthe contract can return a code; the claim page checks the key first and says so.",
          "name": "BadSecret",
          "value": 3
        },
        {
          "doc": "keep_bps above 10,000.",
          "name": "BadRate",
          "value": 4
        },
        {
          "doc": "Below the minimum send, or a keep slice that would buy nothing.",
          "name": "TooSmall",
          "value": 5
        },
        {
          "doc": "return_at outside [now + 1 day, now + 1 year].",
          "name": "BadReturnDate",
          "value": 6
        },
        {
          "doc": "The keep asset is not on the table, or is disabled.",
          "name": "AssetOff",
          "value": 7
        },
        {
          "doc": "Too early: a stranger before the return date, or a measurement before 30 days.",
          "name": "NotYet",
          "value": 8
        },
        {
          "doc": "Reserved. A refund names its caller; a stranger before the date gets NotYet.",
          "name": "NotSender",
          "value": 9
        },
        {
          "doc": "Still held was already measured for this envelope.",
          "name": "AlreadyMeasured",
          "value": 10
        },
        {
          "doc": "Arithmetic out of range.",
          "name": "Overflow",
          "value": 11
        },
        {
          "doc": "The pool does not trade USDC at in_idx for the asset at out_idx.",
          "name": "BadPool",
          "value": 12
        },
        {
          "doc": "Only Claimed envelopes can be measured.",
          "name": "NotClaimed",
          "value": 13
        }
      ]
    }
  },
