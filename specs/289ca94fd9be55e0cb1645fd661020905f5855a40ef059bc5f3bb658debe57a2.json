    "udt_struct_v0": {
      "doc": "What a union sets for the Nila accounts that name it (executive decision 3 Nov: member-owned\\naccounts; was the per-union account factory). Signed by the union account (2 of 3).\\nnila-account decodes the same type (kept apart from nila-common so the other contracts do not\\ncarry its spec).",
      "lib": "",
      "name": "UnionSettings",
      "fields": [
        {
          "doc": "The fx_pool that may lock an account's USDC for LP positions, and the USDC (none: no LPs).\\nBoth or neither.",
          "name": "fx_pool",
          "type_": {
            "option": {
              "value_type": "address"
            }
          }
        },
        {
          "doc": "The contracts a leader session may call for an account: only contracts the trust gave the\\ncore role (`set_role(.., Core, true)`), i.e. fund_core (executive decision 4 Nov).",
          "name": "session_contracts",
          "type_": {
            "vec": {
              "element_type": "address"
