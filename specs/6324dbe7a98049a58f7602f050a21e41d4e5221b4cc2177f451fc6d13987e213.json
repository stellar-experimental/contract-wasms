  {
    "udt_union_v0": {
      "doc": "What an arriving deposit is for. Fixed per adapter at deploy: SAFU runs\\none adapter per mode, and the user's burn names the adapter, so the intent\\nis chosen by the user's own signed burn and cannot be switched by a relayer.",
      "lib": "",
      "name": "DepositMode",
      "cases": [
        {
          "void_v0": {
            "doc": "Stake into the pool (coverage for the staker's wallets).",
