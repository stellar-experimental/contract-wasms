  {
    "function_v0": {
      "doc": "`transmitter` = Circle MessageTransmitterV2, `messenger` = Circle\\nTokenMessengerMinterV2 (passed on to each account for outbound burns),\\n`usdc` = the USDC SAC CCTP mints, `pool` = SAFU protection-pool,\\n`account_wasm` = the uploaded `safu-account` WASM hash, `mode` = what\\ndeposits through this adapter are for.",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "transmitter",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "messenger",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "usdc",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "pool",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "account_wasm",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "mode",
          "type_": {
            "udt": {
              "name": "DepositMode"
            }
          }
        }
      ],
      "outputs": []
    }
  },
