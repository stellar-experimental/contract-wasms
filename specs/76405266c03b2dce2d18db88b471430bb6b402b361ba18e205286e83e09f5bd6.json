      "inputs": [
        {
          "doc": "",
          "name": "vault",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "shares",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "to",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "FeeReceiverError"
              }
            }
          }
        }
      ]
    }
  },
  {
