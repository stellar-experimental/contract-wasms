    "function_v0": {
      "doc": "Moves this contract's whole balance of `token` to the treasury (\\xc2\\xa75.10). Admin. The\\ntreasury is the only destination, so there is no address to get wrong; the keeper\\nconverts or withdraws from there under the treasury's rules. A zero balance is not an\\nerror. Only intermediate dust can ever be here: every hop pulls exactly its input and\\nthe swap refunds any leftover input.",
      "name": "sweep",
      "inputs": [
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
