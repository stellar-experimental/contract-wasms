  {
    "function_v0": {
      "doc": "Swaps exactly `amount_in` of `token_in` for at least `min_out` of `token_out` through\\n`routes`, each route's hops run in order with this contract as caller and each hop's\\nreturned amount feeding the next. Returns the amount of `token_out` delivered. Fee in\\n`token_in` per v3 \\xc2\\xa75.3; the routes' shares add up to the post-fee amount (\\xc2\\xa75.3). \\xc2\\xa75.4\\nlists the steps in order.",
      "name": "swap_exact_in",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "min_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "routes",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Route"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "partner",
          "type_": {
            "option": {
              "value_type": {
                "udt": {
                  "name": "Partner"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Buys at least `amount_out` of `token_out` (everything delivered is paid out) for at\\nmost `max_in` of `token_in`, fee included. The routes are exact-in hops sized by the\\napi from a forward quote; the fee is taken on the input they consumed (\\xc2\\xa75.5). Returns\\nthe input spent, hops plus fee.",
      "name": "swap_exact_out",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "max_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "routes",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Route"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "partner",
          "type_": {
            "option": {
              "value_type": {
                "udt": {
                  "name": "Partner"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
