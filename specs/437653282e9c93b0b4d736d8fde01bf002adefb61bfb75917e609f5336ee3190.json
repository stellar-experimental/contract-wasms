  {
    "udt_error_enum_v0": {
      "doc": "Spec \\xc2\\xa75.8. Numbering is part of the api contract: the api maps codes to messages.",
      "lib": "",
      "name": "AggregatorError",
      "cases": [
        {
          "doc": "",
          "name": "Paused",
          "value": 1
        },
        {
          "doc": "",
          "name": "InvalidAmount",
          "value": 2
        },
        {
          "doc": "",
          "name": "SameToken",
          "value": 3
        },
        {
          "doc": "",
          "name": "PartnerBpsOutOfRange",
          "value": 4
        },
        {
          "doc": "\\xc2\\xa75.3: empty routes or hops, non-positive share, shares that do not add up, broken\\ncontinuity, an Aqua hop without steps, an Aqua return above `i128::MAX`, or a Sushi\\npool returning `i128::MIN` on the received leg, where `checked_neg` fails.",
          "name": "BadRoute",
          "value": 5
        },
        {
          "doc": "A Comet hop left `allowance(aggregator, pool) > 0` after the call (\\xc2\\xa75.7).",
          "name": "AllowanceLeft",
          "value": 6
        },
        {
          "doc": "Delivered less than `min_out` (exact-in) or `amount_out` (exact-out).",
          "name": "InsufficientOutput",
          "value": 7
        },
        {
          "doc": "Exact-out: the hops consumed no input, or the leftover input cannot cover the fee.",
          "name": "InsufficientInput",
          "value": 8
        },
        {
          "doc": "",
          "name": "NoPendingAdmin",
          "value": 9
        },
        {
          "doc": "A dial above `MAX_BPS`, or `min_partner_bps < protocol_bps`.",
          "name": "BpsOutOfRange",
          "value": 10
        },
        {
          "doc": "`Partner.id` is longer than 9 characters (not a `SymbolSmall`).",
          "name": "PartnerIdTooLong",
          "value": 11
        },
        {
          "doc": "Config missing. Unreachable after the constructor; kept so the read has no unwrap.",
          "name": "NotInitialized",
          "value": 12
        }
      ]
    }
  },
