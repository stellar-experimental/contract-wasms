  {
    "function_v0": {
      "doc": "Execute the full cycle. Returns realised profit in USDC stroops.\\nAny `Err` (or a panic in a nested call) reverts every leg.\\n\\n* `usdc_in`     \\xe2\\x80\\x94 USDC spent on BLND in Comet v1.1.\\n* `blnt_to_xlm` \\xe2\\x80\\x94 how much of the received BLNT goes to the BLNT/XLM pool;\\nthe remainder goes to BLNT/USDC. Must be in `0..=blnt_received`.\\n* `min_profit`  \\xe2\\x80\\x94 revert unless `usdc_out - usdc_in >= min_profit`.",
      "name": "run",
      "inputs": [
        {
          "doc": "",
          "name": "usdc_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "blnt_to_xlm",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_profit",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
