    }
  },
  {
    "udt_struct_v0": {
      "doc": "A role a promotion leads to.",
      "lib": "",
      "name": "RoleConfig",
      "fields": [
        {
          "doc": "The NQG a member needs to ask for it, 6 decimals.",
          "name": "min_nqg",
          "type_": "i128"
        },
        {
          "doc": "Its name, in the title of the proposal, at most `MAX_ROLE_NAME_LEN`.",
          "name": "name",
          "type_": "string"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "An account on an external platform verified by an operator.",
      "lib": "",
      "name": "SocialAccount",
      "fields": [
        {
          "doc": "Display handle at the time of verification.",
          "name": "handle",
          "type_": "string"
        },
        {
          "doc": "Stable identifier on the platform (e.g. Discord snowflake).",
          "name": "id",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "provider",
          "type_": {
            "udt": {
              "name": "Provider"
            }
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "The length of the Pilots' votes on promotions and the NQG a member needs to\\nask. The Tansu contract and project are the admin's settings.",
      "lib": "",
      "name": "PromotionConfig",
      "fields": [
        {
          "doc": "The wait between two requests of a token, in seconds, at most\\n`MAX_REQUEST_INTERVAL`.",
          "name": "request_interval",
          "type_": "u64"
        },
        {
          "doc": "The roles a promotion leads to: entry `i` is role `i + 1`, so\\n`TOP_ROLE` entries.",
          "name": "roles",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "RoleConfig"
                }
              }
            }
          }
        },
        {
          "doc": "Length of the Pilots' vote in seconds, from `MIN_VOTING_PERIOD` to\\n`POWER_HOLD`.",
          "name": "voting_period",
          "type_": "u64"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "",
      "lib": "",
      "name": "RecoveryRequest",
      "fields": [
        {
          "doc": "",
          "name": "executable_at",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "new_address",
          "type_": "address"
        },
        {
          "doc": "The operator that proposed it. A recovery is only as good as the\\noperator behind it, so removing that operator voids it while it is out\\nof the set: added back, its requests count again.",
          "name": "operator",
          "type_": "address"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "",
      "lib": "",
      "name": "ExternalAccounts",
      "fields": [
        {
          "doc": "At most one account per provider.",
          "name": "accounts",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "SocialAccount"
                }
              }
            }
          }
        },
        {
          "doc": "sha256 of the trimmed, lowercased email, as verified by an\\noperator. Not unique across members: it links a member to its\\ncontributions in PG Atlas, it does not identify one.",
          "name": "email_hash",
          "type_": {
            "option": {
              "value_type": {
                "bytes_n": {
                  "n": 32
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "",
      "lib": "",
      "name": "PromotionRequest",
      "fields": [
        {
          "doc": "The `project_epoch` of the settings when asked: a later one is another\\nproject, whose proposals are numbered anew.",
          "name": "epoch",
          "type_": "u32"
        },
        {
          "doc": "The proposal on the project of `epoch`.",
          "name": "proposal_id",
          "type_": "u32"
        },
        {
          "doc": "The role asked for.",
          "name": "role",
          "type_": "u32"
        }
      ]
    }
  },
  {
    "udt_error_enum_v0": {
      "doc": "",
      "lib": "",
      "name": "MembershipError",
      "cases": [
        {
          "doc": "The caller is neither the token owner nor an operator.",
          "name": "UnauthorizedSigner",
          "value": 100
        },
        {
          "doc": "The address is not an operator, or is the admin and cannot be one.",
          "name": "UnauthorizedOperator",
          "value": 101
        },
        {
          "doc": "The address is already an operator, appears twice in a new set, or\\nis an operator named as admin.",
          "name": "OperatorAlreadyExist",
          "value": 102
        },
        {
          "doc": "The change would leave the contract without an operator.",
          "name": "NoOperators",
          "value": 103
        },
        {
          "doc": "Indicates a non-existent `token_id`.",
          "name": "NonExistentToken",
          "value": 200
        },
        {
          "doc": "Indicates a non-existent `trait_key`.",
          "name": "TraitDoesNotExist",
          "value": 201
        },
        {
          "doc": "The address already holds a token.",
          "name": "MemberAlreadyExist",
          "value": 202
        },
        {
          "doc": "The external account is bound to another token.",
          "name": "AccountAlreadyBound",
          "value": 203
        },
        {
          "doc": "More projects than `MAX_PROJECTS`.",
          "name": "TooManyProjects",
          "value": 204
        },
        {
          "doc": "A string is empty or exceeds its maximum length.",
          "name": "InvalidLength",
          "value": 205
        },
        {
          "doc": "The token has been revoked.",
          "name": "TokenRevoked",
          "value": 206
        },
        {
          "doc": "More than one account for a provider.",
          "name": "DuplicateProvider",
          "value": 207
        },
        {
          "doc": "The role is above `TOP_ROLE`.",
          "name": "InvalidRole",
          "value": 208
        },
        {
          "doc": "No recovery is pending for this token.",
          "name": "NoRecovery",
          "value": 301
        },
        {
          "doc": "The operator that proposed the recovery is no longer one.",
          "name": "ProposerNotOperator",
          "value": 302
        },
        {
          "doc": "The recovery was not finalized within its window.",
          "name": "RecoveryExpired",
          "value": 303
        },
        {
          "doc": "The delay of the recovery has not elapsed yet.",
          "name": "RecoveryNotReady",
          "value": 304
        },
        {
          "doc": "The contract is paused.",
          "name": "ContractPaused",
          "value": 400
        },
        {
          "doc": "No promotion is pending for this token.",
          "name": "NoPromotion",
          "value": 500
        },
        {
          "doc": "A promotion is already pending for this token.",
          "name": "PromotionPending",
          "value": 501
        },
        {
          "doc": "The member holds `TOP_ROLE`, the last role.",
          "name": "TopRole",
          "value": 502
        },
        {
          "doc": "The NQG of the member is below the minimum of the next role.",
          "name": "NqgTooLow",
          "value": 503
        },
        {
          "doc": "The operators have set no promotion config.",
          "name": "NoPromotionConfig",
          "value": 504
        },
        {
          "doc": "The end of the vote is not the voting period from now, within\\n`SIGNING_MARGIN`.",
          "name": "InvalidVotingEnd",
          "value": 505
        },
        {
          "doc": "This contract is not a maintainer of the Tansu project.",
          "name": "NotMaintainer",
          "value": 506
        },
        {
          "doc": "The member asked for a promotion less than the request interval ago.",
          "name": "RequestTooSoon",
          "value": 507
        },
        {
          "doc": "The Tansu project does not weigh its votes with this contract's NQG.",
          "name": "NotNqgContract",
          "value": 508
        },
        {
          "doc": "The voting period is longer than `POWER_HOLD`, which would let a\\nmoved key vote twice.",
          "name": "VotingPeriodTooLong",
          "value": 509
        },
        {
          "doc": "The voting period is shorter than `MIN_VOTING_PERIOD`, twice\\n`SIGNING_MARGIN`, which keeps every vote at least half its period.",
          "name": "VotingPeriodTooShort",
          "value": 510
        },
        {
          "doc": "The request interval is longer than `MAX_REQUEST_INTERVAL`.",
          "name": "RequestIntervalTooLong",
          "value": 511
        },
