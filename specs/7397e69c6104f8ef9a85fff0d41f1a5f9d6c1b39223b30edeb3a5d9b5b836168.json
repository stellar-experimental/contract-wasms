    "function_v0": {
      "doc": "Single entrypoint: verifies `circuits/main.circom` Groth16 proof and public signals, checks\\ntree root and nullifiers, appends new output commitments (with ephemeral keys, not in Merkle),\\nthen applies public token deposits / withdrawals: `publicDepositedAssets` + `publicDeposits`\\npull from `from`, and `publicWithdrawnAssets` + `publicWithdrawals` send to the Stellar\\naccount from `withdrawAddressHi` / `withdrawAddressLo`.\\n\\nThe proof-bound escrow recipient reconstructed from public signals is the only\\nauthorization subject. Both limbs zero means a non-sweep: both sweep output owner\\ncoordinates must also be zero. A nonzero pair is a sweep: that account must\\n`require_auth()` (host account credentials, so multisig and rotated signers work; a\\nrevoked key cannot), must already have a private address in the registry, and both\\nsweep output owner coordinates must equal that registry key.\\n\\nAsset ids: Stellar **contract** token `C...` addresses encoded as two field elements (same 32-byte\\nsplit as account keys \\xe2\\x80\\x94 see `cir",
      "name": "transact",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "nonce",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "proof_bytes",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "pub_signals_bytes",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "ciphertext_bytes",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "kyt_authorization",
          "type_": {
            "option": {
              "value_type": {
                "udt": {
                  "name": "KytPassageAuthorization"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
