  {
    "udt_struct_v0": {
      "doc": "Snapshot of the lent reserve, for monitors and curators.",
      "lib": "",
      "name": "ReserveStatus",
      "fields": [
        {
          "doc": "b-token to underlying rate, 12 decimals. A drop means a socialised loss.",
          "name": "b_rate",
          "type_": "i128"
        },
        {
          "doc": "Whether the reserve accepts new supply. Precept only lets it go from true to false.",
          "name": "enabled",
          "type_": "bool"
        },
        {
          "doc": "Precept pool status. Supply is blocked above 3; withdrawals are never blocked by it.",
          "name": "pool_status",
          "type_": "u32"
        },
        {
          "doc": "Total borrowed, in underlying units.",
          "name": "total_liabilities",
          "type_": "i128"
        },
        {
          "doc": "Total supplied, in underlying units.",
          "name": "total_supply",
          "type_": "i128"
        },
        {
          "doc": "`total_liabilities / total_supply`, 7 decimals.",
          "name": "utilization",
          "type_": "i128"
        }
      ]
    }
  },
