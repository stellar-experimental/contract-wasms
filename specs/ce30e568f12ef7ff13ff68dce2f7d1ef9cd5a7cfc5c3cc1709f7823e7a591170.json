  {
    "function_v0": {
      "doc": "Lends `amount` to the pool and credits `from` with the b-tokens it minted. Returns\\n`from`'s balance afterwards. Reverts when deposits are paused, when `from` is not\\nallowlisted, and (from the pool) when the pool status is above 3 or the reserve is\\ndisabled.",
      "name": "deposit",
      "inputs": [
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "StrategyError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Nothing to claim: Precept pays lenders through `b_rate`. The keeper calls it to record\\na price-per-share checkpoint (the reserve's `b_rate`, 12 decimals) in the event log.",
