  {
    "function_v0": {
      "doc": "Pulls up to `max_amount` of `token` from the vault (its allowance to\\nthis contract is the outer budget), lets the settler take the priced\\namount, returns the rest. Caps count what the settler actually took.\\n`sig` is the vault's SEP-53 signature over [`pull_message`].",
      "name": "fill",
      "inputs": [
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "max_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "solver",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "order_id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "outputs",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "MandateOutput"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "fill_deadline",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "auth",
          "type_": {
            "udt": {
              "name": "PullAuth"
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
