  {
    "function_v0": {
      "doc": "Zero-registration constant-envelope arbitrage (`arb_auto`) with automatic\\nBlend v2 flash-loan expansion:\\n- When `salt & 1 != 0`, `avail` expands to `max(user_bal, 95% of Blend cash)`.\\n- If `best_in <= user_bal`, pulls `best_in` from `user` via `transfer_from`\\nand executes directly on `self_addr`.\\n- If `best_in > user_bal` (whale trigger or 0-balance token like EURC),\\nflash-borrows `best_in` from `Blend` via companion `Exec` (`exec_op`),\\nrepays Blend (`+1..2 stroops`), and transfers net profit to `user`.",
      "name": "arb_auto",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "legs",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Leg"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "salt",
          "type_": "u64"
        }
      ],
      "outputs": [
        "u128"
      ]
    }
