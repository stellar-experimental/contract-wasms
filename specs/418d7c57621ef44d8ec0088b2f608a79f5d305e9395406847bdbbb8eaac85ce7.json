  {
    "function_v0": {
      "doc": "Fills `part` of an order, all of it if `part` covers what is left. Fails if its condition or its minimum isn't met.\\nAn expired order is closed and refunded instead. Returns the two sides of the fill: (XLM, tokens). `hint` is needed\\nonly for a coin from an outside launchpad of the Lumen kind: the keeper reads it from a simulation of this fill.",
      "name": "fill",
      "inputs": [
        {
          "doc": "",
          "name": "keeper",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "part",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "hint",
          "type_": {
            "option": {
              "value_type": {
                "udt": {
                  "name": "PadHint"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "tuple": {
            "value_types": [
              "i128",
              "i128"
            ]
          }
        }
      ]
    }
  },
