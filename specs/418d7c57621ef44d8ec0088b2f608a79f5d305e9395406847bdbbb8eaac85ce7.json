  {
    "udt_struct_v0": {
      "doc": "* The one pool call an outside launchpad of the Lumen kind makes for whoever trades through it, which that trader has to\\n * authorise. A contract can only authorise a call it doesn't make itself by naming it exactly, so a keeper reads these\\n * figures from a simulation of the same fill and passes them in. A wrong figure authorises nothing: the call it names\\n * never happens and the trade fails, so the keeper can't make it do anything else.",
      "lib": "",
      "name": "PadHint",
      "fields": [
        {
          "doc": "The pool's `swap_strict_receive(user, in_idx, out_idx, out_amount, in_max)` arguments after `user`.",
          "name": "in_idx",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "in_max",
          "type_": "u128"
        },
        {
          "doc": "",
          "name": "out_amount",
          "type_": "u128"
        },
        {
          "doc": "",
          "name": "out_idx",
          "type_": "u32"
        },
        {
          "doc": "What the pool then takes from the trader, in the input coin.",
          "name": "pay",
          "type_": "i128"
        },
        {
          "doc": "The Aquarius pool the launchpad swaps on.",
          "name": "pool",
          "type_": "address"
        }
      ]
    }
  }
