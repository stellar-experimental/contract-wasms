    "function_v0": {
      "doc": "Phase-0 Classic -> Phase-1 Soroban atomic gate (`L65202588` / `L65202591`,\\nIssue #3208): requires `token_in.balance(user) >= min_user_bal` after Phase-0\\nClassic settlement before pulling `total_in` into the Soroban legs.\\nBecause `token_in.transfer(user, self, total_in)` already puts `user`'s\\n`token_in` balance entry in the read-write footprint, this check adds zero\\nfootprint keys and zero Classic semaphore operations.",
      "name": "ss_if",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "branches",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Branch"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "out_min",
          "type_": "u128"
        },
        {
          "doc": "",
          "name": "min_user_bal",
          "type_": "i128"
        },
        {
          "doc": "",
