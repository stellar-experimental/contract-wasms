    "udt_error_enum_v0": {
      "doc": "",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "Instruction count is zero or above the program cap, or the split-weight\\ncount is above its cap.",
          "name": "EmptyBatch",
          "value": 1
        },
        {
          "doc": "Non-positive amount, overdraft, or spend mismatch.",
          "name": "InvalidAmount",
          "value": 3
        },
        {
          "doc": "`Prev` has no predecessor output, or it names a different token.",
          "name": "BrokenTokenChain",
          "value": 4
        },
        {
          "doc": "Declared minimum output is not positive, or the delivered output is\\nbelow it.",
          "name": "SlippageExceeded",
          "value": 5
        },
        {
          "doc": "Venue returned zero usable output.",
          "name": "ZeroOutput",
          "value": 7
        },
        {
          "doc": "Checked arithmetic overflow.",
          "name": "IntegerOverflow",
          "value": 9
        },
        {
          "doc": "A split weight is zero.",
          "name": "ZeroSplitPpm",
          "value": 11
        },
        {
          "doc": "A split weight exceeds 1e6.",
          "name": "SplitPpmMismatch",
          "value": 12
        },
        {
          "doc": "Strategy XDR or packed program failed to decode or validate.",
          "name": "InvalidRouteXdr",
          "value": 13
        },
        {
          "doc": "Ownable owner missing when required.",
          "name": "NotAdmin",
          "value": 20
        },
        {
          "doc": "Fee bps above [`crate::constants::FEE_CAP`].",
          "name": "FeeTooHigh",
          "value": 21
        },
        {
          "doc": "Referral id not in storage.",
          "name": "ReferralNotFound",
          "value": 22
        },
        {
          "doc": "Input and output token are identical.",
          "name": "SameToken",
          "value": 25
        },
        {
          "doc": "Declared LP token is not the pool share token.",
          "name": "LpTokenMismatch",
          "value": 26
        },
        {
          "doc": "`mint_min_shares` is not positive, or the mint delivered fewer shares.",
          "name": "MinSharesNotMet",
          "value": 27
        },
        {
          "doc": "Burn constituent below its min amount.",
          "name": "MinAmountsNotMet",
          "value": 28
        },
        {
          "doc": "Leftover vault balance exceeds residual allowance.",
          "name": "ExcessiveResidual",
          "value": 29
        },
        {
          "doc": "A contract-internal invariant no longer holds; the call fails closed.\\nUnreachable on a fresh deployment of this build. An in-place upgrade\\nfrom a build without `DataKey::ReservedTotal` is unsupported and\\nsurfaces this code on fee claims.",
          "name": "InternalInvariant",
          "value": 30
        }
      ]
    }
