  {
    "function_v0": {
      "doc": "Anyone can call this once the curve is sold out. Returns the new pool.\\n\\n`fix_amount` is 0 normally. If someone opened the pool early at another price, the caller can\\npass a correction swap (simulated off chain): `fix_buy` spends up to 5% of the quote on tokens\\nwhen the pool is cheaper than the curve, otherwise up to 5% of the kept tokens are sold when\\nit is dearer. Either way the swap must fill at the curve price or better, so the coin never\\npays for it; the mispriced liquidity does.",
      "name": "graduate",
      "inputs": [
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "fix_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "fix_buy",
          "type_": "bool"
        }
      ],
      "outputs": [
        "address"
      ]
    }
  },
